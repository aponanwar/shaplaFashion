# ============================================================
# SHAPLA FASHION — Example Environment Variables
# Copy this file to .env.local and fill in your real values
# ============================================================

# App
NEXT_PUBLIC_APP_NAME="Shapla Fashion"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DESCRIPTION="Authentic Bangladeshi Clothes & Homemade Crafts"

# MongoDB (Free Tier optimized: maxPoolSize=10)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shapla_fashion?retryWrites=true&w=majority&maxPoolSize=10&minPoolSize=1&maxIdleTimeMS=30000&serverSelectionTimeoutMS=5000"
MONGODB_DB_NAME="shapla_fashion"

# NextAuth
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN"
NEXTAUTH_URL="http://localhost:3000"

# Admin Credentials (initial seed)
ADMIN_EMAIL="admin@shaplaFashion.com"
ADMIN_PASSWORD="ChangeMe@123!"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_PRESET="shapla_fashion_preset"

# Stripe (Card Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_SECRET_KEY="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"

# bKash Payment Gateway
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Nagad Payment Gateway
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_MERCHANT_PRIVATE_KEY="your_nagad_private_key"
NAGAD_MERCHANT_PUBLIC_KEY="your_nagad_public_key"
NAGAD_BASE_URL="https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0"

# WhatsApp Business
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER="+8801XXXXXXXXX"
NEXT_PUBLIC_WHATSAPP_BUSINESS_NAME="Shapla Fashion"
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_VERIFY_TOKEN="your_webhook_verify_token_random_string"

# SMS Gateway
SMS_API_KEY="your_sms_api_key"
SMS_SENDER_ID="ShaplFash"
SMS_BASE_URL="https://api.sslwireless.com/api/v3"

# Courier Automation (Steadfast / Pathao API)
STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET_KEY="your_steadfast_secret_key"
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# Business Information
NEXT_PUBLIC_BUSINESS_ADDRESS="Dhaka, Bangladesh"
NEXT_PUBLIC_BUSINESS_PHONE="+8801XXXXXXXXX"
NEXT_PUBLIC_BUSINESS_EMAIL="support@shapla-fashion.com"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/ShaplaFashion"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/ShaplaFashion"
